// Prisma schema for Countryboy bus ticketing system
// All tables are prefixed with "tbl" as per spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role definitions
model tblRoles {
  id        String   @id @default(uuid())
  name      String   @unique
  users     tblUserRoles[]
}

model tblUserRoles {
  id     String        @id @default(uuid())
  user   tblAdminUsers @relation(fields: [userId], references: [id])
  userId String
  role   tblRoles      @relation(fields: [roleId], references: [id])
  roleId String

  @@unique([userId, roleId])
}

model tblDepots {
  id            String   @id @default(uuid())
  merchant_code String   @unique
  name          String
  location      String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    String?
  updated_by    String?

  adminUsers       tblAdminUsers[]
  agents           tblAgents[]
  devices          tblDevices[]
  fleets           tblFleets[]
  drivers          tblDrivers[]
  routes           tblRoutes[]
  routeLinks       tblRouteLinks[]
  fares            tblFares[]
  trips            tblTrips[]
  tickets          tblTickets[]
  serialRanges     tblSerialRanges[]
  syncLogs         tblSyncLogs[]
  dailyAggregates  tblDailyAggregates[]
  agentDeviceSessions tblAgentDeviceSessions[]
}

model tblAdminUsers {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  phone        String?
  password_hash String
  full_name    String?
  depot_id     String?  // null for super admins
  status       String   @default("ACTIVE")
  last_seen_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  created_by   String?
  updated_by   String?

  depot        tblDepots? @relation(fields: [depot_id], references: [id])
  roles        tblUserRoles[]
  voids        tblTicketVoids[]
}

model tblAgents {
  id          String   @id @default(uuid())
  full_name   String
  username    String?                      // Optional - for web portal access if needed
  agent_code  String
  pin         String?                      // Optional 4-6 digit PIN for quick daily login
  depot_id    String
  status      String   @default("ACTIVE")  // ACTIVE, INACTIVE, SUSPENDED, TERMINATED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  updated_by  String?

  depot        tblDepots @relation(fields: [depot_id], references: [id])
  trips        tblTrips[]
  tickets      tblTickets[]
  voids        tblTicketVoids[] @relation("VoidAgent")
  deviceSessions tblAgentDeviceSessions[]
  devicesLastUsed tblDevices[] @relation("DeviceLastAgent")

  @@unique([depot_id, username])
  @@unique([depot_id, agent_code])
}

model tblDevices {
  id            String   @id @default(uuid())
  serial_number String   @unique
  token         String?  @unique           // Long token for API authentication (UUID)
  pairing_code  String?  @unique           // Short 6-char code for one-time device pairing
  paired        Boolean  @default(false)   // Whether device has been paired with app
  paired_at     DateTime?                  // When device was paired
  last_agent_id String?                    // Last conductor who signed in on this device
  last_agent_login_at DateTime?
  depot_id      String
  device_name   String?                    // Device brand and model (e.g., "Samsung SM A556E")
  device_model  String?                    // Device model (e.g., "SM A556E")
  /// Current Bluetooth thermal printer attached to this phone (best-effort).
  printer_name   String?
  printer_mac    String?
  printer_serial String?
  last_seen     DateTime?
  app_version   String?
  sync_errors   Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    String?
  updated_by    String?

  depot         tblDepots @relation(fields: [depot_id], references: [id])
  lastAgent     tblAgents? @relation("DeviceLastAgent", fields: [last_agent_id], references: [id])
  trips         tblTrips[]
  tickets       tblTickets[]
  serialRanges  tblSerialRanges[]
  voids         tblTicketVoids[] @relation("VoidDevice")
  agentDeviceSessions tblAgentDeviceSessions[]
}

model tblAgentDeviceSessions {
  id          String    @id @default(uuid())
  depot_id    String
  device_id   String
  agent_id    String
  started_at  DateTime  @default(now())
  ended_at    DateTime?
  end_reason  String?
  app_version String?
  login_type  String    @default("online")

  depot       tblDepots  @relation(fields: [depot_id], references: [id])
  device      tblDevices @relation(fields: [device_id], references: [id])
  agent       tblAgents  @relation(fields: [agent_id], references: [id])

  @@index([device_id, ended_at])
  @@index([agent_id, started_at])
  @@index([depot_id, started_at])
}

model tblFleets {
  id                           String      @id @default(uuid())
  number                       String
  registration_number          String?
  depot_id                     String
  status                       FleetStatus @default(ACTIVE)
  capacity                     Int         @default(0)
  licence_disc_expiry          DateTime?   // Vehicle Licence Disc
  cof_expiry                   DateTime?   // Certificate of Fitness
  passenger_liability_expiry   DateTime?   // Passenger Liability Insurance
  route_authority_expiry       DateTime?   // Route Authority
  ppa_expiry                   DateTime?   // Public Passenger Permit (PPA)
  created_at                   DateTime    @default(now())
  updated_at                   DateTime    @updatedAt
  created_by                   String?
  updated_by                   String?

  depot       tblDepots @relation(fields: [depot_id], references: [id])
  trips       tblTrips[]

  @@unique([depot_id, number])
  @@unique([depot_id, registration_number])
}

enum FleetStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model tblDrivers {
  id            String   @id @default(uuid())
  full_name     String
  employee_code String?
  phone         String?
  licence_number String?
  depot_id      String
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    String?
  updated_by    String?

  depot         tblDepots @relation(fields: [depot_id], references: [id])
  trips         tblTrips[]

  @@unique([depot_id, employee_code])
  @@index([depot_id, status])
}

model tblRoutes {
  id          String   @id @default(uuid())
  origin      String
  destination String
  depot_id    String
  is_active   Boolean  @default(true)
  distance_km Decimal? @db.Decimal(8, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  updated_by  String?

  depot       tblDepots @relation(fields: [depot_id], references: [id])
  fares       tblFares[]
  trips       tblTrips[]
  parentLinks tblRouteLinks[] @relation("RouteLinkParent")
  childLinks  tblRouteLinks[] @relation("RouteLinkChild")

  @@unique([depot_id, origin, destination])
}

/// Many-to-many corridor links: a segment route can belong under multiple parents,
/// and a parent can itself be linked under another corridor.
model tblRouteLinks {
  id              String   @id @default(uuid())
  depot_id        String
  parent_route_id String
  child_route_id  String
  created_at      DateTime @default(now())
  created_by      String?

  depot        tblDepots @relation(fields: [depot_id], references: [id])
  parentRoute  tblRoutes @relation("RouteLinkParent", fields: [parent_route_id], references: [id], onDelete: Cascade)
  childRoute   tblRoutes @relation("RouteLinkChild", fields: [child_route_id], references: [id], onDelete: Cascade)

  @@unique([parent_route_id, child_route_id])
  @@index([depot_id])
  @@index([child_route_id])
}

model tblFares {
  id          String   @id @default(uuid())
  route_id    String
  depot_id    String
  currency    String
  amount      Decimal @db.Decimal(12, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  updated_by  String?

  route       tblRoutes @relation(fields: [route_id], references: [id])
  depot       tblDepots  @relation(fields: [depot_id], references: [id])
}

model tblTrips {
  id              String   @id @default(uuid())
  depot_id        String
  agent_id        String
  device_id       String?
  fleet_id        String
  driver_id       String?
  /// Legacy link to admin route catalog (optional; new trips use origin/destination).
  route_id        String?
  /// Conductor-entered trip corridor.
  origin          String
  destination     String
  started_at      DateTime
  ended_at        DateTime?
  status          String   @default("ACTIVE")
  started_offline Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  created_by      String?
  updated_by      String?

  depot       tblDepots @relation(fields: [depot_id], references: [id])
  agent       tblAgents @relation(fields: [agent_id], references: [id])
  device      tblDevices? @relation(fields: [device_id], references: [id])
  fleet       tblFleets @relation(fields: [fleet_id], references: [id])
  driver      tblDrivers? @relation(fields: [driver_id], references: [id])
  route       tblRoutes? @relation(fields: [route_id], references: [id])
  tickets     tblTickets[]

  @@index([depot_id, origin, destination])
  @@index([driver_id])
}

model tblTickets {
  id                        String   @id @default(uuid())
  depot_id                  String
  trip_id                   String
  agent_id                  String
  device_id                 String?
  serial_number             Int?
  ticket_category           String
  currency                  String
  amount                    Decimal @db.Decimal(12, 2)
  /// Manual luggage charge. For PASSENGER_WITH_LUGGAGE, amount = passenger fare + luggage_amount.
  luggage_amount            Decimal? @db.Decimal(12, 2)
  departure                 String?
  destination               String?
  passenger_name            String?
  passenger_phone           String?
  luggage_description       String?
  printed                   Boolean  @default(false)
  printed_at                DateTime?
  /// Snapshot of Bluetooth printer used when the ticket was printed.
  printer_name              String?
  printer_mac               String?
  printer_serial            String?
  linked_passenger_ticket_id String?
  issued_at                 DateTime
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  created_by                String?
  updated_by                String?

  depot               tblDepots @relation(fields: [depot_id], references: [id])
  trip                tblTrips @relation(fields: [trip_id], references: [id])
  agent               tblAgents @relation(fields: [agent_id], references: [id])
  device              tblDevices? @relation(fields: [device_id], references: [id])
  linkedPassengerTicket tblTickets? @relation("TicketLuggage", fields: [linked_passenger_ticket_id], references: [id])
  luggageTickets      tblTickets[] @relation("TicketLuggage")
  voids               tblTicketVoids[]

  @@index([depot_id, issued_at])
  @@index([depot_id, agent_id, issued_at])
}

// Additional tables for analytics/support

model tblTicketVoids {
  id             String   @id @default(uuid())
  ticket_id      String
  reason         String
  created_at     DateTime @default(now())
  agent_id       String?
  device_id      String?
  admin_user_id  String?

  ticket         tblTickets @relation(fields: [ticket_id], references: [id])
  agent          tblAgents? @relation("VoidAgent", fields: [agent_id], references: [id])
  device         tblDevices? @relation("VoidDevice", fields: [device_id], references: [id])
  adminUser      tblAdminUsers? @relation(fields: [admin_user_id], references: [id])
}

model tblSyncLogs {
  id             String   @id @default(uuid())
  depot_id       String
  device_id      String?
  agent_id       String?
  type           String   // push or pull
  success        Boolean  @default(true)
  error          String?
  records_pushed Int?
  records_pulled Int?
  duration_ms    Int?
  created_at     DateTime @default(now())

  depot          tblDepots @relation(fields: [depot_id], references: [id])
}

model tblSerialRanges {
  id           String    @id @default(uuid())
  depot_id     String
  device_id    String
  currency     String
  start_number Int
  end_number   Int
  next_number  Int
  allocated_at DateTime  @default(now())
  exhausted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  depot        tblDepots @relation(fields: [depot_id], references: [id])
  device       tblDevices @relation(fields: [device_id], references: [id])

  @@unique([depot_id, device_id, currency, start_number])
}

model tblDailyAggregates {
  id          String   @id @default(uuid())
  depot_id    String
  date        DateTime
  currency    String
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  ticket_count Int     @default(0)

  depot       tblDepots @relation(fields: [depot_id], references: [id])

  @@unique([depot_id, date, currency])
}

/// Singleton org-wide portal settings (always id = "default").
model tblSystemSettings {
  id                 String   @id @default("default")
  company_name       String   @default("CountryBoy")
  company_email      String?
  company_phone      String?
  support_email      String?
  /// JSON array of enabled ticket currencies, e.g. ["USD","ZWL","ZAR"]
  enabled_currencies Json     @default("[\"USD\", \"ZWL\", \"ZAR\"]")
  default_currency   String   @default("USD")
  timezone           String   @default("Africa/Harare")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  updated_by         String?
}
