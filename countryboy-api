server {
    server_name api.countryboy.co.zw;

    server_tokens off;

    # Large APK/AAB publishes (up to ~150 MB). Keep this ABOVE the catch-all `/`.
    # Body size / timeouts alone do not speed up the wire — but rate limits and
    # request buffering on this path absolutely hurt large multipart uploads.
    client_max_body_size 150M;
    client_body_timeout 300s;
    client_body_buffer_size 1m;

    # Block hidden files and sensitive files
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* ^/(?:\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|Dockerfile|docker-compose\.yml|README|README\.md)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Dedicated upload path — no request-rate / connection caps (those are for API spam,
    # not a single 120 MB multipart POST).
    location ^~ /api/app-releases {
        # Do NOT apply limit_req / limit_conn here.

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Avoid some clients stalling on Expect: 100-continue with large bodies
        proxy_set_header Expect "";

        # Stream body to Node as it arrives (do not spool entire APK on Nginx disk first)
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;

        proxy_connect_timeout 120s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        client_max_body_size 150M;
        client_body_timeout 300s;
    }

    location / {
        limit_req zone=api_limit burst=20 nodelay;
        limit_conn addr 20;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;

        proxy_connect_timeout 120s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        client_max_body_size 150M;
    }

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/countryboy.co.zw/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/countryboy.co.zw/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = api.countryboy.co.zw) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name api.countryboy.co.zw;
    return 404; # managed by Certbot
}
